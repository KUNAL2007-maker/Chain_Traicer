# Copy to .env.local and fill in your own values. .env.local is gitignored;
# never commit real secrets. The app reads .env.local then .env at startup.

# ── Session signing ─────────────────────────────────────────────────────────
# Signs the browser-session cookie that holds the logged-in uid. Any long random
# string. If unset, a random key is generated per process — which simply signs
# everyone out on restart (the app's session is not meant to survive a restart).
#   python -c "import os; print(os.urandom(32).hex())"
SESSION_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Optional. Absolute or relative path to the SQLite file. Defaults to
# finguard.db in the project root. Set this to move the DB (e.g. onto a mounted
# disk in a container).
FINGUARD_DB=

# ── AI (investigator chat) ──────────────────────────────────────────────────
# Google AI Studio key, from https://aistudio.google.com/apikey — powers the
# investigator chat. Without it the console still works and still detects
# everything; it falls back to the local analysis engine for reports.
#
# GEMINI_API_KEY is the documented name. GOOGLE_API_KEY,
# GOOGLE_GENERATIVE_AI_API_KEY and GOOGLE_AI_API_KEY are read as aliases, because
# Google's own tooling disagrees about the name and a deployment dashboard is an
# easy place to pick the wrong one.
GEMINI_API_KEY=

# Optional. Tokens per minute the governor believes it may spend before it makes
# a user wait. Only worth setting if you hit quota refusals on the default.
GEMINI_TPM=
