# ─────────────────────────────────────────────────────────────────────────────
# CryptoTrace (SIH26183) — environment
#
# EVERY key below is OPTIONAL. With none set, the console runs a fully-featured
# demo: /api/trace serves a realistic multi-chain laundering scenario, the I4C
# assistant answers from the built-in forensic engine (no network), and the app
# signs you straight in as a local officer with nothing persisted. Add keys to
# go live. Copy this file to `.env.local` and fill in what you have.
#
# `.env.local` is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (login + case persistence) ─────────────────────────────────────
# Without these the console runs in "offline demo" mode: no login screen, and
# traces / notices / case metadata vanish on refresh. With them, each officer
# signs in and their case file is stored under users/{uid}/… in Firestore.
#
# Get them from: Firebase console → Project settings → General → Your apps →
# SDK setup and configuration → Config. Then, in the same project:
#   1. Build → Authentication → Sign-in method → enable Email/Password
#   2. Build → Firestore Database → Create database → Native mode
#      → location asia-south1 (Mumbai)
#   3. Firestore → Rules → paste the contents of `firestore.rules` → Publish
#   4. Authentication → Settings → Authorized domains → add your Render domain
#
# These are NEXT_PUBLIC_*, so they are baked into the browser bundle. That is
# expected and safe for Firebase client config — access is enforced by the
# Firestore rules, not by hiding these values. What must never be committed is
# a service-account JSON, and this app does not use one (no Admin SDK).
#
# ⚠ Render gotcha: NEXT_PUBLIC_* vars are inlined at BUILD time. They must exist
# in Render's environment before the first build, and changing one needs a
# rebuild (Clear build cache & deploy) — a restart will not pick it up.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Live blockchain tracing ─────────────────────────────────────────────────
# With these set, /api/trace walks the money live instead of using the demo
# dataset. Missing a chain's key simply means that chain contributes nothing.
#   Etherscan (Ethereum + Polygon, ERC-20/USDT):  https://etherscan.io/apis
#     One key covers both chains via the V2 multichain endpoint (?chainid=).
#     Verified 2026-08-26: chainid=1 and chainid=137 both return live data.
#   TronGrid  (TRON, TRC-20/USDT):                https://www.trongrid.io/
#   Bitcoin uses mempool.space and needs no key.
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=

# Escape hatch: repoint the Etherscan host without a code change (a V1 fallback
# if V2 is ever retired, or a local stub in tests). Leave unset in normal use.
# ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api

# ── Token pricing ───────────────────────────────────────────────────────────
# CoinGecko, for live USD/INR values. Strongly recommended: the amount stated
# in a Section 91 / Section 94 notice is derived from these, and without a key
# the app falls back to a static table that will drift from the market.
# A free "Demo" key works: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Set to true ONLY for a paid Pro key. Both Demo and Pro keys start with "CG-",
# so the prefix cannot tell them apart — and a Demo key sent to the Pro host is
# rejected with HTTP 400, after which prices silently revert to the static
# table. Leave this unset unless you are actually paying for Pro.
# COINGECKO_PRO=true

# ── AI narrative (I4C assistant) ────────────────────────────────────────────
# Google Gemini key. Without it, the assistant degrades to the local four-agent
# report — it never shows an error. The code also reads GOOGLE_API_KEY /
# GOOGLE_GENERATIVE_AI_API_KEY / GOOGLE_AI_API_KEY, but GEMINI_API_KEY is the
# name to prefer so the next person can find it.
GEMINI_API_KEY=

# Per-minute token budget for the governor (input+output). Optional; the app
# ships a sane default. Raise or lower to match your Gemini quota.
# GEMINI_TPM=32000
