# Secrets — real values live in .env.local (never committed).
.env
.env.local
.env*.local

.DS_Store
*.log

# Local agent workspace, not part of the app.
.claude/

# Superseded copy of the whole app, kept locally only.
new raisoni/

# Report, deck, video and the screenshots they are built from — large binaries
# that are outputs of the project, not source.
deliverables/

# ── Python backend (FastAPI) ────────────────────────────────────────────────
# Bytecode and caches.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Virtualenvs.
.venv/
venv/
env/
# Runtime SQLite database (+ WAL sidecars) — created on first run, holds local
# data, never source.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
